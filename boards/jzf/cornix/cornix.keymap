#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        // Decrease Alacritty font (Ctrl -) and equalize Vim panes (Ctrl W, =)
        ala_vim_dec: ala_vim_dec {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(MINUS)>, <&kp LC(W)>, <&kp EQUAL>;
        };

        // Increase Alacritty font (Ctrl =) and equalize Vim panes (Ctrl W, =)
        ala_vim_inc: ala_vim_inc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LC(EQUAL)>, <&kp LC(W)>, <&kp EQUAL>;
        };
    };

    behaviors {
        shft_f1: shift_f1 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N1>, <&kp F1>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f2: shift_f2 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N2>, <&kp F2>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f3: shift_f3 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N3>, <&kp F3>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f4: shift_f4 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N4>, <&kp F4>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f5: shift_f5 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N5>, <&kp F5>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f6: shift_f6 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N6>, <&kp F6>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f7: shift_f7 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N7>, <&kp F7>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f8: shift_f8 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N8>, <&kp F8>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f9: shift_f9 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N9>, <&kp F9>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        shft_f10: shift_f10 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp N0>, <&kp F10>; mods = <(MOD_LSFT|MOD_RSFT)>; };
    };

    combos {
        compatible = "zmk,combos";

        // Combo to flash keyboard (DFU)
        combo_bootloader {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Default Layer.
        layer0 {
            bindings = <
&kp TAB    &kp Q    &kp W  &kp E &kp R       &kp T                             &kp Y     &kp U       &kp I      &kp O       &kp P    &kp BSPC
&kp ESC    &kp A    &kp S  &kp D &kp F       &kp G                             &kp H     &kp J       &kp K      &kp L       &kp SEMI &kp RET
&kp LSHFT  &kp Z    &kp X  &kp C &kp V       &kp B    &kp K_MUTE  &kp PAGE_UP  &kp N     &kp M       &kp COMMA  &kp DOT     &kp FSLH &kp QUESTION
&tog 5     &kp LALT &tog 4 &mo 1 &lt 3 SPACE &kp LGUI                          &kp LCTRL &lt 3 SPACE &mo 2      &kp PAGE_UP &kp BSLH &kp PAGE_DOWN
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        // Red layer -- symbols
        layer1 {
            bindings = <
&kp GRAVE &shft_f1 &shft_f2  &shft_f3  &shft_f4  &shft_f5                   &shft_f6    &shft_f7   &shft_f8  &shft_f9         &shft_f10         &kp BSPC
&kp HASH  &kp AT   &kp EXCL  &kp AMPS  &kp PIPE  &kp DLLR                   &kp ASTRK   &kp MINUS  &kp UNDER &kp SINGLE_QUOTE &kp DOUBLE_QUOTES &kp PLUS
&kp LBKT  &kp RBKT &kp CARET &kp TILDE &kp EQUAL &kp PERCENT &trans  &trans &kp LPAR    &kp RPAR   &kp LT    &kp GT           &kp LBRC          &kp RBRC
&trans    &trans   &trans    &trans    &trans    &trans                     &trans      &trans     &trans    &trans           &trans            &trans
            >;
        };

        // Layer green -- navigation
        layer2 {
            bindings = <
&bt BT_CLR    &kp LC(LEFT) &kp LC(RIGHT)     &trans    &kp RA(N5)    &trans                    &kp RA(Y)  &kp RA(U)  &kp RA(I)  &kp RA(O)  &kp RA(P) &trans
&bt BT_SEL 0  &kp RA(A)    &kp PG_UP         &kp PG_DN &kp HOME      &kp END                   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans    &trans
&bt BT_SEL 1  &trans       &kp LC(LS(SPACE))           &kp RA(COMMA) &trans     &trans     &trans  &trans &kp RA(N)  &trans     &kp RA(COMMA)  &trans &trans    &trans
&bt BT_SEL 2  &trans       &trans            &trans    &trans     &trans                    &trans     &trans     &trans         &trans &trans    &trans
            >;
        };

        // Layer spacebar -- apps and desktop manager
        layer3 {
            bindings = <
&trans  &trans     &trans      &trans     &kp LS(TAB) &kp LC(PG_DN)                &ala_vim_dec &ala_vim_inc  &kp LS(INS) &kp LC(LS(C)) &kp LC(LS(V)) &trans
&trans  &trans     &trans      &trans     &kp RET     &kp BSPC                     &kp BSPC     &kp RET       &trans      &trans        &trans        &trans
&trans  &kp LG(N1) &kp LG(N2)  &kp LG(N3) &kp LG(N4)  &kp LG(N5)    &trans  &trans &kp LG(N6)   &kp LG(N7)    &kp LG(N8)  &kp LG(N9)    &kp LG(N0)    &kp ESC
&trans  &trans     &trans      &trans     &trans      &trans                                  &trans       &trans        &trans      &trans        &trans        &trans
            >;
        }; // layer 3

        // Mouse layer (Layer 4)
        layer4 {
            bindings = <
&to 0   &trans     &trans       &trans    &trans          &trans                        &mkp MB2        &msc SCRL_UP    &mkp MB4        &trans           &trans  &trans
&trans  &trans     &mkp MB3     &mkp MB2  &mkp MB1        &trans                        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans     &trans       &trans    &msc SCRL_LEFT  &msc SCRL_RIGHT &trans &trans &mkp MB1        &msc SCRL_DOWN  &mkp MB5        &trans           &trans  &trans
&trans  &trans     &trans       &trans    &trans          &trans                        &trans          &mkp MB1        &trans          &trans           &trans  &trans
            >;
        };

        // Numpad Layer (Layer 5)
        layer5 {
            bindings = <
&to 0   &trans     &trans     &trans    &trans   &trans               &kp COMMA  &kp N7     &kp N8     &kp N9     &kp BSPC   &trans
&trans  &kp PLUS   &kp MINUS  &kp ASTRK &kp FSLH &trans               &kp N0     &kp N4     &kp N5     &kp N6     &kp RET    &trans
&trans  &trans     &trans     &trans    &trans   &trans &trans &trans &kp DOT    &kp N1     &kp N2     &kp N3     &kp EQUAL  &trans
&trans  &trans     &trans     &trans    &trans   &trans               &trans     &trans     &kp DOT    &trans     &trans     &trans
            >;
        };
    }; // keymap
}; // close root
